# Prevent Vercel from detecting and installing Python backend dependencies
/requirements.txt
/requirements-phase0.txt
/services/
/tests/
/fixtures/
/docs/
*.py
/.venv/
__pycache__/

# Native desktop and Rust tools (not needed for web deployment)
/Cargo.toml
/Cargo.lock
/target/
/apps/desktop/src-tauri/
/tools/
/print-bot.exe

# Never ignore frontend sources and distribution downloads
!public/**
!public/downloads/**
!src/**
!apps/**/src/**
