{
  "name": "printbot-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production Multi-Tenant Print Shop SaaS Platform, Windows Desktop Workstation & Marketing Landing Page",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:landing": "vite",
    "build:landing": "vite build",
    "preview:landing": "vite preview",
    "dev:web": "pnpm --filter @xerox/web dev",
    "dev:desktop": "pnpm --filter @xerox/desktop dev",
    "dev:api": "uvicorn services.api.main:app --reload --port 8000",
    "dev:worker": "python -m services.worker.worker",
    "build:customer": "pnpm --filter @xerox/customer-web build",
    "build:all": "pnpm -r build",
    "test": "pnpm -r test && pytest tests/",
    "test:api": "pytest tests/ -v",
    "test:bench": "python tests/benchmark_latency.py",
    "lint": "pnpm -r lint",
    "lint:landing": "node .agents/skills/design-taste-frontend/scripts/lint.mjs src",
    "inspect": "node .agents/skills/design-taste-frontend/scripts/inspect.mjs dist/index.html",
    "type-check": "pnpm -r type-check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
