# ==============================================================================
# PrintExpress Environment Configuration (2-Database SaaS Architecture)
# DO NOT COMMIT REAL PRODUCTION SECRETS
# ==============================================================================

ENVIRONMENT=development
APP_NAME="PrintExpress Multi-Tenant SaaS"

# ------------------------------------------------------------------------------
# 1. ADMIN SUPABASE DATABASE (Super Admin Platform: Shops, Subscriptions, Licenses)
# ------------------------------------------------------------------------------
ADMIN_SUPABASE_URL=https://your-admin-project-id.supabase.co
ADMIN_SUPABASE_SERVICE_ROLE_KEY=your_admin_secret_key

# ------------------------------------------------------------------------------
# 2. SHARED SHOP SUPABASE DATABASE (Operational DB: Orders, Prices, Prints)
# ------------------------------------------------------------------------------
SHOP_SUPABASE_URL=https://your-shop-project-id.supabase.co
SHOP_SUPABASE_SERVICE_ROLE_KEY=your_shop_secret_key

# ------------------------------------------------------------------------------
# 3. CLIENT FRONTEND & WORKSTATION CONFIGURATION
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-shop-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_shop_publishable_key
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
