# Environment Configuration (Template - DO NOT COMMIT REAL SECRETS)
ENVIRONMENT=development
APP_NAME="Xerox SaaS Cloud API"

# API & Security
SECRET_KEY=replace-with-a-64-character-cryptographically-secure-random-secret
WEBHOOK_SIGNING_SECRET=whsec_replace_with_live_webhook_signing_key_from_stripe_or_razorpay
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres

# Caching & Queue (Redis / Upstash)
REDIS_URL=redis://default:your-redis-token@your-redis-endpoint:6379/0

# Object Storage (Cloudflare R2 / S3)
STORAGE_BUCKET=xerox-customer-documents
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_DOMAIN=https://documents.your-printflow-domain.com

# Observability
SENTRY_DSN=
