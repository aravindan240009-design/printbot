# ==============================================================================
# Print Bot Phase 1 Environment Configuration (FOSS-First)
# DO NOT COMMIT REAL PRODUCTION SECRETS
# ==============================================================================

ENVIRONMENT=development
APP_NAME="Print Bot Multi-Tenant SaaS"
API_V1_STR=/api/v1

# Security & Sessions (Replace with 64-character random string in production)
SECRET_KEY=dev-insecure-secret-key-change-me-in-production-64-bytes-needed-here-1234
WEBHOOK_SIGNING_SECRET=whsec_dev_mock_signing_key_44321
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL 16 (Local / Podman / Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_dev_secret_change_me@localhost:5432/printbot_db

# Valkey / Redis (Open-source BSD-3-Clause)
REDIS_URL=redis://localhost:6379/0

# Permissively Licensed Object Store (SeaweedFS / MinIO S3 API)
STORAGE_BUCKET=printbot-assets
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY_ID=any
S3_SECRET_ACCESS_KEY=any
S3_PUBLIC_DOMAIN=http://localhost:8333/printbot-assets

# Mailpit Local Email Sandbox
SMTP_HOST=localhost
SMTP_PORT=1025

# Single All-Inclusive Subscription Configuration
SUBSCRIPTION_PLAN_ID=ALL_INCLUSIVE
SUBSCRIPTION_PRICE_MONTHLY_PAISE=99900
SUBSCRIPTION_PRICE_ANNUAL_PAISE=999000
SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# Device Pairing Configuration
DEVICE_PAIRING_CODE_TTL_SECONDS=600
DEVICE_TOKEN_EXPIRE_MINUTES=60
